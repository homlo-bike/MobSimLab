{
  "_comment": "The range map (area reachable out and back on one charge), the trip there and back coloured by the kind of street, the bike-lane gap picked in the tab, and the charging points and bike parkings along the route. Class ids come from crates/cargo-bike (Class), amenity kinds from the API's bike-amenity tiles.",
  "layers": [
    {
      "id": "cargo-bike-range-fill",
      "type": "fill",
      "source": "range",
      "paint": {
        "fill-color": "#16a34a",
        "fill-opacity": 0.12
      }
    },
    {
      "id": "cargo-bike-range-line",
      "type": "line",
      "source": "range",
      "paint": {
        "line-color": "#15803d",
        "line-width": 2,
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "cargo-bike-gap",
      "type": "line",
      "source": "gap",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#facc15",
        "line-width": 18,
        "line-opacity": 0.7
      }
    },
    {
      "id": "cargo-bike-trip-casing",
      "type": "line",
      "source": "trip",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": 8
      }
    },
    {
      "id": "cargo-bike-trip",
      "type": "line",
      "source": "trip",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-width": 5,
        "line-color": [
          "match",
          ["get", "class"],
          "separated",
          "#15803d",
          "lane",
          "#65a30d",
          "quiet",
          "#2563eb",
          "mixed",
          "#dc2626",
          "#64748b"
        ]
      }
    },
    {
      "id": "cargo-bike-amenity",
      "type": "circle",
      "source": "amenity",
      "paint": {
        "circle-radius": 7,
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff",
        "circle-color": [
          "match",
          ["get", "kind"],
          "charging",
          "#d97706",
          "secure_parking",
          "#7c3aed",
          "cargo_parking",
          "#0e7490",
          "#64748b"
        ]
      }
    }
  ],
  "legend": [
    {
      "class": "separated",
      "color": "#15803d"
    },
    {
      "class": "lane",
      "color": "#65a30d"
    },
    {
      "class": "quiet",
      "color": "#2563eb"
    },
    {
      "class": "mixed",
      "color": "#dc2626"
    }
  ],
  "amenities": [
    {
      "kind": "charging",
      "color": "#d97706"
    },
    {
      "kind": "secure_parking",
      "color": "#7c3aed"
    },
    {
      "kind": "cargo_parking",
      "color": "#0e7490"
    }
  ]
}
