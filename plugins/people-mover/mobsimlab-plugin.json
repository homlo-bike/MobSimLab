{
  "$schema": "../../contracts/plugin-manifest.schema.json",
  "id": "org.mobsimlab.people-mover",
  "name": "People movers",
  "description": "Cable-hauled automated people movers on an elevated guideway, drawn with the straight spans kit: shuttles with two trains, and pinched loops with detachable trains that stop in every station (ADR-0037 §7). Self-propelled people movers need the railway editor and come later.",
  "translations": "i18n",
  "version": "0.1.0",
  "publisher": { "name": "MobSimLab contributors", "url": "https://github.com/homlo-bike/MobSimLab" },
  "license": "AGPL-3.0-or-later",
  "dataLicense": "CC-BY-4.0",
  "engines": { "mobsimlab": ">=0.1 <1", "pluginApi": "1" },
  "bundled": true,
  "tiers": ["data"],
  "contributes": {
    "modes": [
      { "id": "people_mover", "file": "modes/people_mover.json" },
      { "id": "people_mover_shuttle", "file": "modes/people_mover_shuttle.json" }
    ],
    "contexts": [
      {
        "key": "apm_system",
        "label": "People mover system",
        "options": [
          { "id": "pinched_loop", "label": "Pinched loop, detachable trains" },
          { "id": "shuttle", "label": "Shuttle, two trains on a fixed rope" }
        ]
      }
    ],
    "parameters": [{ "file": "assumptions/parameters.yaml" }],
    "sources": [{ "file": "assumptions/sources.yaml" }],
    "tools": [
      {
        "id": "people-mover",
        "label": "People mover",
        "hint": "Cable-hauled shuttles and loops on a guideway: click stations, piers follow.",
        "kit": "straight-spans",
        "modes": ["people_mover", "people_mover_shuttle"]
      }
    ]
  },
  "permissions": ["read:network"]
}
