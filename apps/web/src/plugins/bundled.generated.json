    {
      "id": "org.mobsimlab.noise",
      "name": "Noise map",
      "description": "Estimated noise of the service lines (ADR-0038): a live noise band while drawing street lines and railways, with checks for curve squeal, bridges and switches. CNOSSOS-EU road emission, free field without buildings for now.",
      "version": "0.1.0",
      "publisher": {
        "name": "MobSimLab contributors",
        "url": "https://github.com/homlo-bike/MobSimLab"
      },
      "license": "AGPL-3.0-or-later",
      "dataLicense": "CC-BY-4.0",
      "bundled": true,
      "tiers": [
        "data",
        "compute"
      ],
      "permissions": [
        "read:network",
        "read:timetable",
        "read:fleet"
      ],
      "modes": [],
      "contexts": [],
      "tools": [],
      "calculations": [
        {
          "id": "noise_estimate",
          "label": "Noise band",
          "description": "L_den and L_night of the drawn lines at 4 m, free field: band distances either side, a receiver grid for the map and checks.",
          "runtime": "bundled-wasm",
          "module": "noise",
          "inputs": [
            "street_lines",
            "rail_design",
            "timetable",
            "fleet",
            "parameters"
          ],
          "outputs": [
            "grid",
            "segments",
            "findings"
          ],
          "where": [
            "street-line-tool",
            "railway-tool",
            "analysis"
          ]
        }
      ],
      "mapLayers": [
        {
          "id": "noise_band",
          "label": "Noise band",
          "calculation": "noise_estimate",
          "style": {
            "_comment": "The noise band is drawn as a picture of the receiver grid (raster), coloured in 5 dB bands after ISO 1996-2 / DIN 45682. Colours are applied by the engine (noise::band_colour); this layer sets how the picture is shown.",
            "layers": [
              {
                "id": "noise-band",
                "type": "raster",
                "paint": {
                  "raster-opacity": 0.6,
                  "raster-resampling": "nearest",
                  "raster-fade-duration": 0
                }
              }
            ],
            "legend": [
              {
                "from_db": 45,
                "color": "#cee4cc"
              },
              {
                "from_db": 50,
                "color": "#e2f2bf"
              },
              {
                "from_db": 55,
                "color": "#f3c683"
              },
              {
                "from_db": 60,
                "color": "#e87e4d"
              },
              {
                "from_db": 65,
