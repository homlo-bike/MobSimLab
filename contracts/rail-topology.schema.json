{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobsimlab.org/contracts/rail-topology.schema.json",
  "title": "Railway topology",
  "description": "The track graph of a railway design for railway operations (ADR-0032, ADR-0033), produced by crates/rail-design (topology module). Positions and geometry are metres east and north of `origin` in the design's local transverse Mercator frame. Offsets along a section (`from_m`, `to_m`) are measured from its `from` node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "mode",
    "modes",
    "valid",
    "errors",
    "nodes",
    "sections",
    "links",
    "switches",
    "platform_edges",
    "crossings",
    "level_crossings",
    "depot_groups",
    "street_running",
    "signals",
    "signals_generated"
  ],
  "properties": {
    "schema": { "const": "mobsimlab.rail-topology/1" },
    "origin": {
      "description": "[longitude, latitude] of the local frame's origin, degrees (WGS84).",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "mode": { "$ref": "#/$defs/mode", "description": "The network's mode." },
    "modes": {
      "description": "Railway systems in the drawing.",
      "type": "array",
      "items": { "$ref": "#/$defs/mode" },
      "minItems": 1,
      "uniqueItems": true
    },
    "valid": { "type": "boolean", "description": "No design errors: operations may use this topology." },
    "errors": { "type": "array", "items": { "type": "string" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "switches": { "type": "array", "items": { "$ref": "#/$defs/switch" } },
    "platform_edges": { "type": "array", "items": { "$ref": "#/$defs/platform_edge" } },
    "crossings": { "type": "array", "items": { "$ref": "#/$defs/crossing" } },
    "level_crossings": { "type": "array", "items": { "$ref": "#/$defs/level_crossing" } },
    "depot_groups": { "type": "array", "items": { "$ref": "#/$defs/depot_group" } },
    "street_running": {
      "description": "Stretches where tram or light rail track embedded in the street runs along a street from OpenStreetMap.",
      "type": "array",
      "items": { "$ref": "#/$defs/street_running" }
    },
    "signals": {
      "description": "Signals (ADR-0030 point 7): the planner's signal plan, or one generated from the design while the document has none.",
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "signals_generated": {
      "type": "boolean",
      "description": "true: the signals were generated on the fly; false: they are the planner's plan."
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "tram",
        "light_rail",
        "metro",
        "commuter_rail",
        "regional_rail",
        "long_distance_rail",
        "high_speed_rail"
      ]
    },
    "metres": { "type": "number", "minimum": 0 },
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "node_id": {
      "description": "w{switch}.{toe} at switch points; otherwise the first section end that meets there, such as s{station}.{track}.a or t{track}.{line}.b.",
      "type": "string",
      "pattern": "^(w\\d+\\.(\\d+|p\\d+\\.[ab])|s\\d+\\.\\d+\\.[ab]|t\\d+\\.\\d+\\.[ab])$"
    },
    "section_id": {
      "description": "t{track}.{line}.{piece} (line 0 is the left track of a double track; pieces are split at switch points), s{station}.{track}, or w{switch}.{leg}.",
      "type": "string",
      "pattern": "^(t\\d+\\.\\d+\\.\\d+|s\\d+\\.\\d+|w\\d+\\.\\d+)$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "switch", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/node_id" },
        "kind": {
          "description": "end: one section (buffer stop or unconnected end); join: two sections; switch: three or more.",
          "enum": ["end", "join", "switch"]
        },
        "switch": { "type": ["integer", "null"], "minimum": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "range_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_m", "to_m", "value"],
      "properties": {
        "from_m": { "$ref": "#/$defs/metres" },
        "to_m": { "$ref": "#/$defs/metres" },
        "value": { "type": "number" }
      }
    },
    "range_level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_m", "to_m", "value"],
      "properties": {
        "from_m": { "$ref": "#/$defs/metres" },
        "to_m": { "$ref": "#/$defs/metres" },
        "value": { "enum": ["underground2", "underground", "street", "elevated", "elevated2", "ramp"] }
      }
    },
    "section": {
      "description": "A physical track between two nodes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "from",
        "to",
        "length_m",
        "mode",
        "gauge_mm",
        "use",
        "power",
        "train_protection",
        "levels",
        "speed_kmh",
        "gradient_permille",
        "radius_m",
        "platform_edges",
        "geometry"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/section_id" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "index", "chainage_m"],
          "properties": {
            "kind": { "enum": ["track", "station", "switch"] },
            "ref": {
              "type": "integer",
              "minimum": 1,
              "description": "Document id of the track, station or switch."
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "description": "Line of a double track, station track index or switch leg."
            },
            "chainage_m": {
              "description": "Chainage range on the track's centre line (track sections only).",
              "oneOf": [
                { "type": "null" },
                { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              ]
            }
          }
        },
        "from": { "$ref": "#/$defs/node_id" },
        "to": { "$ref": "#/$defs/node_id" },
        "length_m": { "$ref": "#/$defs/metres" },
        "mode": { "$ref": "#/$defs/mode" },
        "gauge_mm": { "type": "number", "exclusiveMinimum": 0 },
        "use": { "enum": ["running", "storage"] },
        "train_protection": {
          "enum": ["line_of_sight", "fixed_block", "cbtc", "etcs_l2"],
          "description": "Train control of the section's railway system (signalling.system): driving on sight, fixed blocks with lineside signals, or moving block with cab signalling (CBTC, ETCS Level 2)."
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "system"],
          "properties": {
            "kind": { "enum": ["overhead", "third_rail", "none"] },
            "system": {
              "type": ["string", "null"],
              "description": "Supply system id in the assumption library."
            }
          }
        },
        "levels": { "type": "array", "items": { "$ref": "#/$defs/range_level" }, "minItems": 1 },
        "speed_kmh": { "type": "array", "items": { "$ref": "#/$defs/range_number" } },
        "gradient_permille": {
          "description": "Ramp gradient (the mode's maximum), positive rising from `from` to `to`.",
          "type": "array",
          "items": { "$ref": "#/$defs/range_number" }
        },
        "radius_m": { "type": "array", "items": { "$ref": "#/$defs/range_number" } },
        "platform_edges": { "type": "array", "items": { "type": "string" } },
        "geometry": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 2 }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "end"],
      "properties": {
        "section": { "$ref": "#/$defs/section_id" },
        "end": { "enum": ["from", "to"] }
      }
    },
    "link": {
      "description": "A train may pass from section end a into section end b at the node, and back.",
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "a", "b"],
      "properties": {
        "node": { "$ref": "#/$defs/node_id" },
        "a": { "$ref": "#/$defs/end" },
        "b": { "$ref": "#/$defs/end" }
      }
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "element",
        "label",
        "track",
        "chainage_m",
        "nodes",
        "legs",
        "conflict_sections",
        "diverging_speed_kmh",
        "radius_m",
        "crossing_ratio_n",
        "fouling_points"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["turnout", "double_junction", "crossover", "scissors"] },
        "element": { "type": "string", "description": "Catalogue element (assumptions/switches.yaml)." },
        "label": { "type": "string" },
        "track": { "type": "integer", "minimum": 1 },
        "chainage_m": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node_id" } },
        "legs": { "type": "array", "items": { "$ref": "#/$defs/section_id" }, "minItems": 1 },
        "conflict_sections": {
          "description": "Sections a train in the switch occupies or fouls; one train at a time.",
          "type": "array",
          "items": { "$ref": "#/$defs/section_id" }
        },
        "diverging_speed_kmh": { "type": "number", "exclusiveMinimum": 0 },
        "radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "crossing_ratio_n": { "type": "number", "exclusiveMinimum": 0 },
        "fouling_points": {
          "description": "For each section attached at a switch point: where a train on it is clear of the switch's other routes (track centres at the clearance marker distance). Routes a train passes from one into the other (the approach and either leg) do not foul each other, so the approach gets 0. Detection and reservation of the switch need each section only up to this point.",
          "type": "array",
          "items": { "$ref": "#/$defs/fouling_point" }
        }
      }
    },
    "fouling_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "section", "distance_m", "at_section", "at_offset_m"],
      "properties": {
        "node": { "$ref": "#/$defs/node_id" },
        "section": { "$ref": "#/$defs/section_id" },
        "distance_m": {
          "$ref": "#/$defs/metres",
          "description": "From the node along the section, and on through joins when the point lies beyond the section's end."
        },
        "at_section": { "$ref": "#/$defs/section_id", "description": "Section the fouling point lies on." },
        "at_offset_m": { "$ref": "#/$defs/metres", "description": "Offset from that section's `from` end." }
      }
    },
    "platform_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "station",
        "station_name",
        "track",
        "side",
        "section",
        "from_m",
        "to_m",
        "length_m",
        "height_mm",
        "mode"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^p\\d+\\.\\d+\\.[lr]$" },
        "station": { "type": "integer", "minimum": 1 },
        "station_name": {
          "type": "string",
          "description": "Stations with the same name are one station in several parts (ADR-0032)."
        },
        "track": { "type": "integer", "minimum": 0 },
        "side": { "enum": ["left", "right"] },
        "section": { "$ref": "#/$defs/section_id" },
        "from_m": { "$ref": "#/$defs/metres" },
        "to_m": { "$ref": "#/$defs/metres" },
        "length_m": { "$ref": "#/$defs/metres" },
        "height_mm": { "type": "number", "minimum": 0 },
        "mode": { "$ref": "#/$defs/mode" }
      }
    },
    "crossing_track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track", "chainage_m", "fouling_before_m", "fouling_after_m", "sections"],
      "properties": {
        "track": { "type": "integer", "minimum": 1 },
        "chainage_m": { "$ref": "#/$defs/metres" },
        "fouling_before_m": {
          "$ref": "#/$defs/metres",
          "description": "Distance back from the crossing to where the other alignment is clear by the clearance marker distance."
        },
        "fouling_after_m": { "$ref": "#/$defs/metres" },
        "sections": {
          "description": "Line sections within the fouling points (same-level crossings only).",
          "type": "array",
          "items": { "$ref": "#/$defs/section_id" }
        }
      }
    },
    "crossing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "conflict", "modes", "angle_deg", "x", "y", "tracks"],
      "properties": {
        "id": { "type": "string", "pattern": "^x\\d+-\\d+-\\d+$" },
        "kind": {
          "description": "diamond: same level, a conflict for one train at a time from either system; grade_separated: no conflict; clash: a design error.",
          "enum": ["diamond", "grade_separated", "clash"]
        },
        "conflict": { "type": "boolean" },
        "modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/mode" },
          "minItems": 2,
          "maxItems": 2
        },
        "angle_deg": { "type": "number", "minimum": 0, "maximum": 90 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/crossing_track" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "level_crossing": {
      "description": "Street-level track crossing a street from OpenStreetMap: a conflict between trains and road vehicles (buses, trolleybuses, depot runs, cars). The railway owns it: it closes the street before a train and clears the train only when the street is closed (ADR-0007).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protection",
        "standard",
        "special_measures",
        "mode",
        "angle_deg",
        "x",
        "y",
        "track",
        "chainage_m",
        "rail_zone_m",
        "sections",
        "line_speed_kmh",
        "warning_time_s",
        "approach_m",
        "street"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lc\\d+-\\d+-\\d+$",
          "description": "lc{track}-{OSM way}-{n}."
        },
        "protection": {
          "description": "barriers: ballasted railway track, barriers and lights; traffic_signals: tram track embedded in the street.",
          "enum": ["barriers", "traffic_signals"]
        },
        "standard": { "type": "boolean", "description": "Meets the usual rules for level crossings." },
        "special_measures": {
          "description": "Why it does not, so the crossing needs special safety measures (full barriers, obstacle detection, train protection): mode (a railway system that normally has no level crossings), third_rail, motorway, line_speed (above the usual limit).",
          "type": "array",
          "items": { "enum": ["mode", "third_rail", "motorway", "line_speed"] },
          "uniqueItems": true
        },
        "mode": { "$ref": "#/$defs/mode" },
        "angle_deg": { "type": "number", "minimum": 0, "maximum": 90 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "track": { "type": "integer", "minimum": 1 },
        "chainage_m": { "$ref": "#/$defs/metres" },
        "rail_zone_m": {
          "$ref": "#/$defs/metres",
          "description": "Half the length of track covered by the street, each side of the crossing point."
        },
        "sections": {
          "description": "Line sections within the rail zone.",
          "type": "array",
          "items": { "$ref": "#/$defs/section_id" }
        },
        "line_speed_kmh": { "type": "number", "minimum": 0 },
        "warning_time_s": { "type": "number", "minimum": 0 },
        "approach_m": {
          "$ref": "#/$defs/metres",
          "description": "Distance before the crossing, in either direction, where an approaching train starts the warning (warning time at line speed)."
        },
        "street": {
          "type": "object",
          "additionalProperties": false,
          "required": ["way", "name", "class", "offset_m", "width_m", "keep_clear_m", "bus", "trolley_wire"],
          "properties": {
            "way": { "type": "integer", "description": "OSM way id." },
            "name": { "type": "string" },
            "class": { "type": "string", "description": "OSM highway value." },
            "offset_m": {
              "$ref": "#/$defs/metres",
              "description": "Distance along the way from its first node."
            },
            "width_m": { "type": "number", "exclusiveMinimum": 0 },
            "keep_clear_m": {
              "$ref": "#/$defs/metres",
              "description": "From the crossing point to each stop line along the street. Road vehicles wait behind it and never stop between the stop lines."
            },
            "bus": { "type": "boolean" },
            "trolley_wire": { "type": "boolean" }
          }
        }
      }
    },
    "depot_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tracks", "sections", "length_m"],
      "properties": {
        "id": { "type": "string", "pattern": "^d\\d+$" },
        "tracks": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section_id" }, "minItems": 1 },
        "length_m": { "$ref": "#/$defs/metres" }
      }
    },
    "street_running": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "track",
        "from_m",
        "to_m",
        "sections",
        "running",
        "speed_limit_kmh",
        "street",
        "stops"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sr\\d+-\\d+-\\d+$",
          "description": "sr{track}-{OSM way}-{n}."
        },
        "track": { "type": "integer", "minimum": 1 },
        "from_m": { "$ref": "#/$defs/metres", "description": "Start on the track's centre-line chainage." },
        "to_m": { "$ref": "#/$defs/metres", "description": "End on the track's centre-line chainage." },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section_id" }, "minItems": 1 },
        "running": {
          "enum": ["reserved", "mixed", "pedestrian_zone"],
          "description": "reserved: the tram has its own lane and road traffic passes beside it; mixed: road traffic drives on the track and the tram runs in traffic; pedestrian_zone: shared with people on foot."
        },
        "speed_limit_kmh": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Road speed limit the tram keeps to on the stretch; already applied to the sections' speed_kmh."
        },
        "street": {
          "type": "object",
          "additionalProperties": false,
          "required": ["way", "name", "class", "width_m", "lanes", "oneway", "bus", "trolley_wire"],
          "properties": {
            "way": { "type": "integer" },
            "name": { "type": "string" },
            "class": { "type": "string", "description": "OSM highway value." },
            "width_m": { "$ref": "#/$defs/metres" },
            "lanes": { "type": "number", "minimum": 0 },
            "oneway": { "type": "boolean" },
            "bus": { "type": "boolean" },
            "trolley_wire": { "type": "boolean" }
          }
        },
        "stops": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Stations (tram stops) on the stretch."
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "chainage_m", "facing", "kind", "overlap_m", "lineside"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(sg|g)\\d+$",
          "description": "sg{document id} for a planned signal, g{n} for a generated one (not stable between exports)."
        },
        "section": { "$ref": "#/$defs/section_id" },
        "chainage_m": { "$ref": "#/$defs/metres", "description": "Offset from the section's from node." },
        "facing": {
          "enum": ["to", "from"],
          "description": "Direction of travel the signal governs: towards the section's to node, or towards its from node."
        },
        "kind": { "enum": ["main", "block", "shunting", "distant"] },
        "overlap_m": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Overlap beyond the signal; null where trains drive on sight."
        },
        "lineside": {
          "type": "boolean",
          "description": "A lineside signal; false for a block marker under cab signalling (CBTC, ETCS Level 2)."
        }
      }
    }
  }
}
