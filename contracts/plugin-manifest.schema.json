{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobsimlab.org/schemas/plugin-manifest/1.json",
  "title": "MobSimLab plugin manifest (mobsimlab-plugin.json)",
  "description": "What a plugin contributes to MobSimLab (ADR-0036 §2 and §3). Producer: plugin authors; the bundled plugins live in plugins/. Consumer: tools/plugins/check.py (validation and the web app's generated registry, apps/web/src/plugins/bundled.generated.json), later the install flow. Plugin API major version 1. Bundled plugins and installed plugins may add project tabs (`tabs`); installed plugins run their own code as WebAssembly components (`runtime: component`, contracts/wit/plugin.wit) and their tabs as sandboxed pages (`ui`). Contribution points that are not built yet (checks, engines, schematics, panels, kpis) are reserved: the schema accepts no entries for them yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "publisher",
    "license",
    "dataLicense",
    "engines",
    "tiers",
    "contributes",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "description": "Reverse-DNS id; everything the plugin contributes is addressed as <id>/<item id>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "version": {
      "description": "SemVer.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "description": "SPDX licence of the code.",
      "type": "string",
      "minLength": 1
    },
    "dataLicense": {
      "description": "SPDX licence of the data contributions; must allow bundling into .mslab exports.",
      "type": "string",
      "minLength": 1
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mobsimlab", "pluginApi"],
      "properties": {
        "mobsimlab": {
          "description": "Range of MobSimLab versions, such as \">=0.1 <1\".",
          "type": "string"
        },
        "pluginApi": {
          "const": "1"
        }
      }
    },
    "bundled": {
      "description": "Ships with the MobSimLab image and is signed with the release key (ADR-0036 §8).",
      "type": "boolean"
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["data", "compute", "ui"]
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "description": "Transport modes; each file follows plugin-mode.schema.json.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem",
            "required": ["id", "file"]
          }
        },
        "contexts": {
          "description": "New assumption context keys with their options (ADR-0018), such as ropeway_system.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "options"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_]*$"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": {
          "description": "Assumption library entries (assumptions/README.md format), each with sources and a global fallback.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem",
            "required": ["file"]
          }
        },
        "sources": {
          "description": "Source register entries used by the plugin's parameters and vehicles.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem",
            "required": ["file"]
          }
        },
        "vehicles": {
          "description": "Folders of vehicle files per vehicles/schema (ADR-0026).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem",
            "required": ["dir"]
          }
        },
        "tools": {
          "description": "Authoring tools for the Create tab: a core authoring kit with the modes it draws.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kit", "modes"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              },
              "kit": {
                "enum": ["straight-spans", "water-route", "service-zone"]
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "calculations": {
          "description": "Calculations over the project's data (ADR-0036 §3, §4). Runtime `bundled-wasm`: a core crate compiled to WebAssembly (tools/wasm/build-<module>.sh, loaded from apps/web/src/wasm/<module>), bundled plugins only. Runtime `component`: a WebAssembly component in the package that targets the `calculation` world of contracts/wit/plugin.wit, run in a sandbox in the browser and the API (installed plugins).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "runtime", "inputs", "outputs"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "runtime": {
                "enum": ["bundled-wasm", "component"]
              },
              "module": {
                "description": "WebAssembly module name under apps/web/src/wasm/ (runtime bundled-wasm).",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "inputs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "network",
                    "street_lines",
                    "rail_design",
                    "timetable",
                    "fleet",
                    "geodata",
                    "parameters"
                  ]
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["grid", "segments", "table", "kpis", "findings"]
                }
              },
              "where": {
                "description": "Where the app offers it: live while drawing in a tool, on demand in the GIS tab (maps over the whole project), in the Tables tab (tables over the whole project), or in Analysis. `plugin-tab`: in a tab the plugin contributes (`tabs`).",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "street-line-tool",
                    "railway-tool",
                    "cable-car-tool",
                    "ferry-tool",
                    "gis",
                    "tables",
                    "analysis",
                    "plugin-tab"
                  ]
                }
              },
              "component": {
                "description": "Path of the WebAssembly component in the package (runtime component), such as wasm/calculation.wasm.",
                "$ref": "#/$defs/packagePath"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "runtime": {
                      "const": "bundled-wasm"
                    }
                  }
                },
                "then": {
                  "required": ["module"],
                  "not": {
                    "required": ["component"]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "runtime": {
                      "const": "component"
                    }
                  }
                },
                "then": {
                  "required": ["component"],
                  "not": {
                    "required": ["module"]
                  }
                }
              }
            ]
          }
        },
        "checks": {
          "$ref": "#/$defs/reserved"
        },
        "engines": {
          "$ref": "#/$defs/reserved"
        },
        "infrastructure": {
          "$ref": "#/$defs/reserved"
        },
        "catalogues": {
          "$ref": "#/$defs/reserved"
        },
        "kpis": {
          "$ref": "#/$defs/reserved"
        },
        "schematics": {
          "$ref": "#/$defs/reserved"
        },
        "importers": {
          "description": "Converters from a file format into a published contract (ADR-0036 §3), offered where the contract is used.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/converter"
          }
        },
        "exporters": {
          "description": "Converters from a published contract into a file format (ADR-0036 §3), offered where the contract is used.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/converter"
          }
        },
        "mapLayers": {
          "description": "Map layers drawn from a calculation's output with a MapLibre style (subset) file.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "calculation", "style"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string"
              },
              "calculation": {
                "type": "string"
              },
              "style": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./-]+$",
                "not": {
                  "pattern": "\\.\\."
                }
              }
            }
          }
        },
        "basemaps": {
          "description": "Aerial basemaps for the map's layer control: raster imagery tiles drawn under the place and street names. Bundled plugins only, because the browser may load tiles only from the hosts the app's Content-Security-Policy lists.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "tiles", "tileSize", "maxzoom", "attribution"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "note": {
                "description": "One sentence under the layer control when this basemap is picked, such as its resolution.",
                "type": "string",
                "maxLength": 300
              },
              "tiles": {
                "description": "Tile URL templates with {z}, {x} and {y}: https URLs on a host the CSP lists, or, with `server`, the API's own path /api/basemaps/<server>/tiles/. {date} is replaced by the picked day (YYYY-MM-DD) when `date` is set.",
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^(https://[A-Za-z0-9.-]+|/api/basemaps/[a-z]+/tiles)/[A-Za-z0-9_./{}-]+$"
                }
              },
              "tileSize": {
                "enum": [256, 512]
              },
              "maxzoom": {
                "description": "Deepest zoom level the server has tiles for; the map enlarges them beyond it.",
                "type": "integer",
                "minimum": 0,
                "maximum": 22
              },
              "attribution": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s\"<>]+$"
                  }
                }
              },
              "date": {
                "description": "Daily imagery: the layer control offers a date, from `first` to today minus `latencyDays` (the default).",
                "type": "object",
                "additionalProperties": false,
                "required": ["first", "latencyDays"],
                "properties": {
                  "first": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "latencyDays": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60
                  }
                }
              },
              "server": {
                "description": "Imagery the API fetches with a key an Admin saved (keys stay on the server): offered only once the Admin has saved it. Tile URLs are then /api/basemaps/<server>/tiles/{z}/{y}/{x}.",
                "enum": ["esri"]
              }
            }
          }
        },
        "panels": {
          "$ref": "#/$defs/reserved"
        },
        "tabs": {
          "description": "Project tabs after the core ones (Simulator … Preferences). A bundled plugin names a view built into the web app (`view`, apps/web/src/features/<view>). An installed plugin ships its own page (`ui`, an HTML file in the package) that the app shows in a sandboxed frame without access to the app, cookies or the network; it talks to the app through a message API that checks the plugin's permissions (ADR-0036 §6). `calculations` lists the plugin's calculations the tab may run.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "view": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "calculations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "ui": {
                "description": "HTML page of the tab in the package (installed plugins), such as tab/index.html; the files next to it are served with it.",
                "$ref": "#/$defs/packagePath"
              }
            },
            "oneOf": [
              {
                "required": ["view"]
              },
              {
                "required": ["ui"]
              }
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read:network",
          "read:timetable",
          "read:fleet",
          "read:geodata",
          "read:results",
          "write:results",
          "write:scenario"
        ]
      }
    },
    "dependsOn": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "fileItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$",
          "not": {
            "pattern": "\\.\\."
          }
        },
        "dir": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+/$",
          "not": {
            "pattern": "\\.\\."
          }
        }
      }
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "format", "contract", "runtime", "maxBytes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "format": {
          "description": "File format, such as gtfs.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "extensions": {
          "description": "File name endings the app offers, such as .zip.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "contract": {
          "description": "The published contract read or written.",
          "enum": ["published-timetable"]
        },
        "runtime": {
          "enum": ["bundled-wasm", "component"]
        },
        "module": {
          "description": "WebAssembly module name under apps/web/src/wasm/ (runtime bundled-wasm).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "function": {
          "description": "Exported function of the module, JSON in and out (runtime bundled-wasm).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "maxBytes": {
          "description": "Largest file the app passes in (import) or may write (export).",
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "component": {
          "description": "Path of the WebAssembly component in the package (runtime component): the `importer` or `exporter` world of contracts/wit/plugin.wit.",
          "$ref": "#/$defs/packagePath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "bundled-wasm"
              }
            }
          },
          "then": {
            "required": ["module", "function"],
            "not": {
              "required": ["component"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "component"
              }
            }
          },
          "then": {
            "required": ["component"],
            "not": {
              "anyOf": [
                {
                  "required": ["module"]
                },
                {
                  "required": ["function"]
                }
              ]
            }
          }
        }
      ]
    },
    "reserved": {
      "description": "Contribution point of a later phase of ADR-0036; no entries are accepted yet.",
      "type": "array",
      "maxItems": 0
    },
    "packagePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_.-]+)*\\.[a-z0-9]+$",
      "not": {
        "pattern": "\\.\\."
      },
      "maxLength": 200
    }
  }
}
