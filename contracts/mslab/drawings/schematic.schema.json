{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/schematic.schema.json",
  "title": "Document of a \"schematic\" drawing (data/schematic.json, field doc)",
  "type": "object",
  "properties": {
    "origin": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "pins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 300
      },
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 300
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      }
    },
    "hidden": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "rotate": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 300
      },
      "additionalProperties": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      }
    },
    "statuses": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 300
      },
      "additionalProperties": {
        "maxItems": 8,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "central_station",
            "bus_station",
            "airport",
            "seaport",
            "park_and_ride",
            "hospital",
            "university",
            "stadium"
          ]
        }
      }
    },
    "areas": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "zone",
              "landmark"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "points": {
            "minItems": 3,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "color",
          "points"
        ],
        "additionalProperties": {}
      }
    },
    "thumb": {
      "type": "object",
      "properties": {
        "w": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "h": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "lines": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "points": {
                "minItems": 2,
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "color",
              "points"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "w",
        "h",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "pins",
    "labels"
  ],
  "additionalProperties": {}
}
