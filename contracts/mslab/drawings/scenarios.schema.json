{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/scenarios.schema.json",
  "title": "Document of a \"scenarios\" drawing (data/scenarios.json, field doc)",
  "type": "object",
  "properties": {
    "scenarios": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "savedAt": {
            "type": "string",
            "maxLength": 40
          },
          "railway": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "origin": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "mode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "stations": {
                    "maxItems": 5000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "tracks": {
                    "maxItems": 20000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "switches": {
                    "maxItems": 20000,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "origin",
                  "mode",
                  "stations",
                  "tracks",
                  "switches"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "streetLines": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lines": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "points": {
                          "maxItems": 2000,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "lonlat": {
                                "type": "array",
                                "prefixItems": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              }
                            },
                            "required": [
                              "lonlat"
                            ],
                            "additionalProperties": {}
                          }
                        }
                      },
                      "required": [
                        "points"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "lines"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "savedAt",
          "railway",
          "streetLines"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "scenarios"
  ],
  "additionalProperties": {}
}
