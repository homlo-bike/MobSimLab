{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/cargo-bike.schema.json",
  "title": "Document of a \"cargo-bike\" drawing (data/cargo-bike.json, field doc)",
  "type": "object",
  "properties": {
    "start": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 60,
        "pattern": "^[a-z_.]+$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "kit": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": {}
}
