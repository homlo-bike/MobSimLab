{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/fleet.schema.json",
  "title": "Document of a \"fleet\" drawing (data/fleet.json, field doc)",
  "type": "object",
  "properties": {
    "vehicles": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^own-[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "name",
          "mode"
        ],
        "additionalProperties": {}
      }
    },
    "units": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "vehicle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "number": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "vehicle",
          "number"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "vehicles",
    "units"
  ],
  "additionalProperties": {}
}
