{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/railway.schema.json",
  "title": "Document of a \"railway\" drawing (data/railway.json, field doc)",
  "type": "object",
  "properties": {
    "origin": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "stations": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {}
      }
    },
    "tracks": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {}
      }
    },
    "switches": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "origin",
    "mode",
    "stations",
    "tracks",
    "switches"
  ],
  "additionalProperties": {}
}
