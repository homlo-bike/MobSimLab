{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/street-lines.schema.json",
  "title": "Document of a \"street-lines\" drawing (data/street-lines.json, field doc)",
  "type": "object",
  "properties": {
    "lines": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "points": {
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lonlat": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "lonlat"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "points"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "lines"
  ],
  "additionalProperties": {}
}
