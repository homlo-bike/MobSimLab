{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/costs.schema.json",
  "title": "Document of a \"costs\" drawing (data/costs.json, field doc)",
  "type": "object",
  "properties": {
    "country": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
