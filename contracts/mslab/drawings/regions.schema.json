{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/drawings/regions.schema.json",
  "title": "Document of a \"regions\" drawing (data/regions.json, field doc)",
  "type": "object",
  "properties": {
    "regions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "ring": {
            "minItems": 4,
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 40
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "ring",
          "values"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "regions"
  ],
  "additionalProperties": {}
}
