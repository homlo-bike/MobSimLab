{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/history.schema.json",
  "title": "History of the project's changed values, newest first (history/values.json)",
  "type": "object",
  "required": [
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "before",
          "after",
          "reason",
          "at",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "changed",
              "reason"
            ]
          },
          "before": {
            "type": "object",
            "required": [
              "value",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "after": {
            "type": "object",
            "required": [
              "value",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "by": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    }
  }
}
