{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/homlo-bike/MobSimLab/blob/main/contracts/mslab/comments.schema.json",
  "title": "Comments on the project's objects (collab/comments.json)",
  "type": "object",
  "required": [
    "comments"
  ],
  "additionalProperties": false,
  "properties": {
    "comments": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objectType",
          "objectId",
          "parentId",
          "body",
          "author",
          "createdAt",
          "editedAt",
          "resolvedAt",
          "resolvedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "objectType": {
            "type": "string",
            "pattern": "^[a-z][a-z-]{1,39}$"
          },
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-fA-F-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "editedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "resolvedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "resolvedBy": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    }
  }
}
