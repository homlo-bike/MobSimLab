# Copy to .env and edit. No secrets here: they live in deploy/secrets (deploy/scripts/init-secrets).
# Folder of the secret files on this computer (db_password, db_admin_password, oidc_client_secret), relative to
# compose.yaml.
# Optional, used only if you provide them as Docker secrets: session_secret (signs CSRF tokens and hashes client
# addresses in the audit log; without it a random key is made at each start, so people reload the page after a
# restart) and master_key (not used yet). To provide them, add to compose.yaml under mobsimlab: secrets, and under
# the top-level secrets:  session_secret: { file: "${MOBSIMLAB_SECRETS_PATH:-./deploy/secrets}/session_secret" }
MOBSIMLAB_SECRETS_PATH=./deploy/secrets
# URL users open in the browser (used for OIDC redirect URIs).
MOBSIMLAB_PUBLIC_URL=http://localhost:8080
# Ready-made image version from ghcr.io/homlo-bike/mobsimlab. There is no "latest" tag: set the release
# you want and change it to update. Only images built locally with --build are tagged latest.
MOBSIMLAB_VERSION=2026.11.1-alpha
# Interface the port is published on. Keep 127.0.0.1 behind a reverse proxy; the instance is not meant
# to be exposed to the internet.
MOBSIMLAB_BIND=127.0.0.1
# Sign-in (OIDC). Register MobSimLab with your identity provider (Keycloak, Authentik, Entra ID, Google, ...)
# with redirect URI  <MOBSIMLAB_PUBLIC_URL>/api/auth/callback. A client secret, if any, goes in
# deploy/secrets/oidc_client_secret.
MOBSIMLAB_OIDC_ISSUER=
MOBSIMLAB_OIDC_CLIENT_ID=
# Required for first setup (and after `mobsimlab admin reset-owner`): the person who becomes the first Owner,
# by e-mail (verified by the provider) or by the provider's subject (user ID). Set at least one: without them,
# setup mode refuses every sign-in, so nobody else who can sign in at the provider claims the instance first.
# The subject is the provider's fixed ID for the account (the "sub" claim, e.g. Keycloak's user ID); use it when
# the provider does not send a verified e-mail. If both are set, the person must match both.
MOBSIMLAB_BOOTSTRAP_OWNER_EMAIL=
MOBSIMLAB_BOOTSTRAP_OWNER_SUBJECT=
# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs, CIDR ranges, or loopback,
# linklocal, uniquelocal). Set this to your TLS proxy's address as MobSimLab sees it; otherwise every client
# appears to come from the proxy and shares one sign-in rate limit. Never list addresses that untrusted clients
# use. Proxy in another container (Nginx Proxy Manager, Traefik, ...): see docs/user/reverse-proxy.md.
MOBSIMLAB_TRUSTED_PROXIES=
# Rate limits per minute: sign-in requests per client address, and state-changing requests per user.
MOBSIMLAB_RATE_LIMIT_AUTH=10
MOBSIMLAB_RATE_LIMIT_WRITES=120
# Development mode: an Owner may then allow unsigned plugins (ADR-0036 §9). Never on an instance with real plans.
MOBSIMLAB_DEVELOPMENT_MODE=false
# Lowest log level written to the container log and to /data/logs (trace, debug, info, warn, error, critical).
# WARN and above are also kept in the database for 30 days, whatever this is set to.
MOBSIMLAB_LOG_LEVEL=info
# Simulation runs at the same time: one background worker process each (1–64). Each running simulation
# can use one CPU core, so keep this at or below the container's CPU limit (MOBSIMLAB_CPUS, default 4).
MOBSIMLAB_SIM_WORKERS=1
# Map data per project (GIS tab, "Data"): OpenStreetMap and the Copernicus GLO-30 elevation grid are imported for
# the box around everything drawn plus the project's buffer. Areas up to OVERPASS_MAX_KM2 come from the Overpass
# API; larger ones from a Geofabrik region download or an uploaded .osm.pbf file, up to OSM_MAX_AREA_KM2.
MOBSIMLAB_OSM_OVERPASS_MAX_KM2=400
MOBSIMLAB_OSM_MAX_AREA_KM2=20000
MOBSIMLAB_OSM_PBF_MAX_MB=4000
MOBSIMLAB_OSM_CACHE_DAYS=7
MOBSIMLAB_GEOFABRIK_URL=https://download.geofabrik.de
MOBSIMLAB_GEOFABRIK_CACHE_DAYS=7
MOBSIMLAB_DEM_MAX_AREA_KM2=20000
MOBSIMLAB_DEM_UPLOAD_MAX_MB=500
# Most grid cells a planner's own elevation GeoTIFF is read or stored in (about 4 bytes of memory each).
MOBSIMLAB_DEM_UPLOAD_MAX_CELLS=25000000
MOBSIMLAB_OSM_TOOL_TIMEOUT_MIN=120
# Heights where the GLO-30 grid cannot be read come from Open-Elevation (open-elevation), or nowhere (off).
# Point MOBSIMLAB_OPEN_ELEVATION_URL at your own Open-Elevation server to keep coordinates in house.
MOBSIMLAB_ELEVATION_FALLBACK=open-elevation
MOBSIMLAB_OPEN_ELEVATION_URL=https://api.open-elevation.com
