# Copy to .env and edit. No secrets here: they live in deploy/secrets (deploy/scripts/init-secrets).
# URL users open in the browser (used for OIDC redirect URIs).
MOBSIMLAB_PUBLIC_URL=http://localhost:8080
# Interface the port is published on. Keep 127.0.0.1 behind a reverse proxy; the instance is not meant
# to be exposed to the internet.
MOBSIMLAB_BIND=127.0.0.1
# Optional: only this e-mail may become the first Owner during setup.
MOBSIMLAB_BOOTSTRAP_OWNER_EMAIL=
