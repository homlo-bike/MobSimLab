# Copy to .env and edit. No secrets here: they live in deploy/secrets (deploy/scripts/init-secrets).
# URL users open in the browser (used for OIDC redirect URIs).
MOBSIMLAB_PUBLIC_URL=http://localhost:8080
# Interface the port is published on. Keep 127.0.0.1 behind a reverse proxy; the instance is not meant
# to be exposed to the internet.
MOBSIMLAB_BIND=127.0.0.1
# Sign-in (OIDC). Register MobSimLab with your identity provider (Keycloak, Authentik, Entra ID, Google, ...)
# with redirect URI  <MOBSIMLAB_PUBLIC_URL>/api/auth/callback. A client secret, if any, goes in
# deploy/secrets/oidc_client_secret. The first person to sign in becomes Owner and runs the setup wizard.
MOBSIMLAB_OIDC_ISSUER=
MOBSIMLAB_OIDC_CLIENT_ID=
# Optional: only this e-mail (verified by the provider) or this subject may become the first Owner.
MOBSIMLAB_BOOTSTRAP_OWNER_EMAIL=
MOBSIMLAB_BOOTSTRAP_OWNER_SUBJECT=
# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs, CIDR ranges, or loopback,
# linklocal, uniquelocal). Set this to your TLS proxy's address; otherwise every client appears to come
# from the proxy and shares one sign-in rate limit. Never list addresses that untrusted clients use.
MOBSIMLAB_TRUSTED_PROXIES=
# Rate limits per minute: sign-in requests per client address, and state-changing requests per user.
MOBSIMLAB_RATE_LIMIT_AUTH=10
MOBSIMLAB_RATE_LIMIT_WRITES=120
