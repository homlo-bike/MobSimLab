#!/usr/bin/env node
// Container health check: exit 0 if the API answers /api/health within 3 s.
const port = process.env.MOBSIMLAB_PORT || "8080";
fetch(`http://127.0.0.1:${port}/api/health`, { signal: AbortSignal.timeout(3000) })
  .then((r) => process.exit(r.ok ? 0 : 1))
  .catch(() => process.exit(1));
