#!/bin/sh
# Create the secret files MobSimLab needs, with random values.
# Existing files are never overwritten. There are no default passwords.
#
# Usage: deploy/scripts/init-secrets [secrets-dir]   (default: deploy/secrets)
#
# The directory is 0700 so other host users cannot read it. The files are 0644
# because Docker bind-mounts them into containers that run as non-root users
# (mobsimlab uid 10001, postgres uid 999), which must be able to read them.
set -eu
umask 077
dir="${1:-$(dirname "$0")/../secrets}"
mkdir -p "$dir"
chmod 700 "$dir"

gen() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32
  else
    head -c 32 /dev/urandom | base64
  fi
}

for name in db_superuser_password db_migrator_password db_app_password db_worker_password master_key session_secret; do
  f="$dir/$name"
  if [ -s "$f" ]; then
    echo "keep    $name"
  else
    gen > "$f"
    chmod 644 "$f"
    echo "created $name"
  fi
done
# Provided by the operator, not generated: left empty for a public OIDC client.
if [ ! -e "$dir/oidc_client_secret" ]; then
  : > "$dir/oidc_client_secret"
  chmod 644 "$dir/oidc_client_secret"
  echo "created oidc_client_secret (empty: paste your identity provider's client secret, if it issued one)"
fi
echo "Secrets are in $dir. Back up master_key: without it, stored provider credentials cannot be decrypted."
